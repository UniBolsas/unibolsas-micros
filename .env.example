# Desenvolvimento local (use com docker-compose)
MONGO_URI="mongodb://localhost:27017/unibolsas"

# Produção (MongoDB Atlas) — não commite a string real, use variável de ambiente no Render
# MONGO_URI="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/<banco>?appName=<app>"

# Token usado pelo cron externo (GitHub Actions) para disparar /scrape/funcap/run
SCRAPE_TOKEN="dev-token"
